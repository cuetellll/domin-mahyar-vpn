{
  "name": "mahyar-vpn",
  "version": "0.1.0",
  "description": "MAHYAR VPN \u2014 an independent domain-fronting desktop client",
  "main": "main.js",
  "author": "MAHYAR VPN contributors",
  "license": "SEE LICENSES",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.mahyar.vpn",
    "productName": "MAHYAR VPN",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "public/**/*",
      "engines/**/*",
      "docs/**/*",
      "MLMVPN-LICENSE.txt",
      "package.json"
    ],
    "asarUnpack": [
      "engines/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "MAHYAR-VPN-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "MAHYAR-VPN-Portable-${version}-${arch}.${ext}"
    }
  }
}
